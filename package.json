{
  "name": "bid360",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-with-db-env.js \"node scripts/run-vercel-migrations.js && prisma generate && next build\"",
    "db:migrate:deploy": "node scripts/run-with-db-env.js \"prisma migrate deploy\"",
    "db:migrate:status": "node scripts/run-with-db-env.js \"prisma migrate status\"",
    "db:validate": "node scripts/run-with-db-env.js \"npx prisma validate\"",
    "db:pull": "node scripts/run-with-db-env.js \"prisma db pull\"",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "rollout:inventory": "node scripts/freeze-workflow-inventory.js",
    "rollout:check": "node scripts/run-workflow-regression.js",
    "rollout:gate": "npm run rollout:inventory && npm run rollout:check",
    "setup:local": "npm run db:migrate:deploy && npm run db:seed:test && npm run dev",
    "db:seed:test": "node scripts/run-with-db-env.js \"node prisma/seed-test-data.js\"",
    "db:reset": "node scripts/run-with-db-env.js \"npx prisma migrate reset --skip-generate\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.102.1",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "google-auth-library": "^10.6.2",
    "iron-session": "^8.0.4",
    "next": "^16.2.6",
    "pdf-parse": "^2.4.5",
    "prisma": "5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
