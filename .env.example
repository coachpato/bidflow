# Copy this file to .env.local for local development.
# Add the same production values in Vercel Project Settings > Environment Variables.

# App URL
# Local: http://localhost:3000
# Production: https://bidflow-livid.vercel.app
# TODO: Replace with the custom domain after it is linked in Vercel.
NEXT_PUBLIC_APP_URL="https://bidflow-livid.vercel.app"

# Database - Prisma/Postgres/Supabase
# Runtime database connection for Vercel/serverless. Prefer the Supabase pooled URL.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection used by Prisma migrations and admin tooling.
# If the direct IPv6 host is unreachable locally, use the Supabase session pooler on port 5432.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional Vercel/Supabase integration aliases supported by lib/prisma.js and scripts/run-with-db-env.js.
POSTGRES_PRISMA_URL=""
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""

# Supabase Storage
# Supabase project URL from Dashboard > Settings > API.
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Supabase service role key. Keep this secret and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Storage bucket used for tender, opportunity, contract, appeal, and compliance documents.
SUPABASE_STORAGE_BUCKET="tender-docs"

# Auth / Sessions
# Secret key for encrypting login sessions. Use a long random string.
SESSION_SECRET="change-this-to-a-long-random-secret-at-least-32-characters"

# Set true only while public self-registration is intentionally open.
ALLOW_PUBLIC_REGISTRATION="false"

# Google Identity Services
# Current auth uses the Google Identity Services popup flow, not a redirect callback route.
# Configure JavaScript origins in Google Cloud for localhost and the production domain.
GOOGLE_CLIENT_ID="[YOUR-GOOGLE-CLIENT-ID]"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="[YOUR-GOOGLE-CLIENT-ID]"

# Email - Resend
# Resend API key for transactional email.
RESEND_API_KEY="re_..."

# Sender address. Use a verified domain before production launch.
EMAIL_FROM="Bid360 <no-reply@your-domain.co.za>"

# Non-production email is dry-run by default. Set true locally only when you intentionally want delivery.
EMAIL_DEV_DELIVER="false"

# Scheduled Jobs
# Secret used to secure cron-triggered endpoints.
CRON_SECRET="change-this-to-a-random-secret"

# Optional comma-separated recipients for crawler/radar digest copies.
CRAWLER_EMAIL_RECIPIENTS=""

# Comma-separated admin recipients that receive a summary after every crawler run
# and an alert when a crawler crash is detected.
CRAWLER_ADMIN_EMAILS=""

# Healthchecks.io/UptimeRobot/Better Uptime heartbeat ping URL.
# For Healthchecks.io, use the ping URL; failures are sent to the same URL with /fail.
CRAWLER_HEARTBEAT_URL=""

# Optional explicit failure URL when your monitor uses a separate failure endpoint.
CRAWLER_HEARTBEAT_FAILURE_URL=""

# Set true to run the pipeline without delivering user digest emails.
# Admin summaries still send so you can verify dry runs safely.
DRY_RUN="false"

# Webhooks
# Keep false on production day one; outbound webhook dispatch short-circuits when disabled.
ENABLE_OUTBOUND_WEBHOOKS="false"

# Logging
# Use debug locally, info in production.
LOG_LEVEL="info"
