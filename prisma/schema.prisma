generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use the pooled connection string for serverless runtime access.
  // Use DIRECT_URL for Prisma migrations and other direct database access.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RunStatus {
  pending
  running
  completed
  completed_with_warnings
  partial_timeout
  failed
  stale
}

model User {
  id                         Int                    @id @default(autoincrement())
  name                       String
  email                      String                 @unique
  password                   String
  googleSubject              String?                @unique
  avatarUrl                  String?
  role                       String                 @default("member")
  emailVerified              DateTime?
  verificationToken          String?                @unique
  verificationTokenExpiresAt DateTime?
  createdAt                  DateTime               @default(now())
  memberships                Membership[]
  tenders                    Tender[]
  assignedTenders            Tender[]               @relation("TenderAssignee")
  assignedContracts          Contract[]             @relation("ContractAssignee")
  tenderStatusChanges        TenderStatusChange[]
  contractStatusChanges      ContractStatusChange[]
  opportunities              Opportunity[]
  activities                 ActivityLog[]
  notifications              Notification[]
  complianceUploads          ComplianceDocument[]   @relation("ComplianceDocumentUploader")
  dislikedOpportunities      Opportunity[]          @relation("OpportunityDislikedBy")
  sentTeamInvites            TeamInvite[]           @relation("TeamInvitesSent")

  @@map("user")
}

model Organization {
  id                  Int                  @id @default(autoincrement())
  name                String
  slug                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         Membership[]
  firmProfile         FirmProfile?
  firmPeople          FirmPerson[]
  firmExperiences     FirmExperience[]
  complianceDocuments ComplianceDocument[]
  opportunities       Opportunity[]
  tenders             Tender[]
  contracts           Contract[]
  appeals             Appeal[]
  opportunityMatches  OpportunityMatch[]
  notifications       Notification[]
  webhookEndpoints    WebhookEndpoint[]
  webhookDeliveries   WebhookDelivery[]
  teamInvites         TeamInvite[]
  setupCompletedAt    DateTime?

  @@map("organization")
}

model Membership {
  id             Int          @id @default(autoincrement())
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int

  @@unique([organizationId, userId])
  @@map("membership")
}

model FirmProfile {
  id                   Int          @id @default(autoincrement())
  displayName          String
  serviceSector        String?
  serviceSectors       String[]     @default([])
  legalName            String?
  registrationNumber   String?
  primaryContactName   String?
  primaryContactEmail  String?
  primaryContactPhone  String?
  website              String?
  overview             String?
  practiceAreas        String[]     @default([])
  preferredEntities    String[]     @default([])
  targetWorkTypes      String[]     @default([])
  targetProvinces      String[]     @default([])
  minimumContractValue Float?
  maximumContractValue Float?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       Int          @unique

  @@map("firmProfile")
}

model FirmPerson {
  id              Int          @id @default(autoincrement())
  fullName        String
  title           String?
  email           String?
  phone           String?
  yearsExperience Int?
  qualifications  String[]     @default([])
  practiceAreas   String[]     @default([])
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int

  @@index([organizationId, yearsExperience])
  @@map("firmPerson")
}

model FirmExperience {
  id             Int          @id @default(autoincrement())
  matterName     String
  clientName     String?
  entityName     String?
  practiceArea   String?
  workType       String?
  summary        String?
  projectValue   Float?
  startedYear    Int?
  completedYear  Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Int

  @@index([organizationId, completedYear])
  @@map("firmExperience")
}

model ComplianceDocument {
  id               Int          @id @default(autoincrement())
  filename         String
  filepath         String
  storagePath      String?
  documentType     String
  description      String?
  issueDate        DateTime?
  expiryDate       DateTime?
  notes            String?
  isDefault        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId   Int
  uploadedBy       User?        @relation("ComplianceDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByUserId Int?

  @@index([organizationId, documentType, isDefault])
  @@index([organizationId, expiryDate])
  @@map("complianceDocument")
}

model PilotLead {
  id                Int      @id @default(autoincrement())
  name              String
  email             String   @unique
  company           String?
  role              String?
  teamSize          String?
  whoWouldUseIt     String
  pricingPreference String?
  monthlyBudget     String?
  lifetimeBudget    String?
  painPoint         String?
  status            String   @default("new")
  createdAt         DateTime @default(now())

  @@map("pilotLead")
}

model Opportunity {
  id                 Int                   @id @default(autoincrement())
  title              String
  reference          String?
  entity             String
  externalId         String?
  dedupeKey          String?
  sourceName         String                @default("eTenders.gov.za")
  sourceUrl          String?
  category           String?
  practiceArea       String?
  summary            String?
  estimatedValue     Float?
  publishedAt        DateTime?
  deadline           DateTime?
  briefingDate       DateTime?
  siteVisitDate      DateTime?
  contactPerson      String?
  contactEmail       String?
  fitScore           Int?
  status             String                @default("New")
  notes              String?
  likedAt            DateTime?
  dislikedAt         DateTime?
  pursuedAt          DateTime?
  parsedRequirements Json?
  parsedAppointments Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId     Int
  createdBy          User?                 @relation(fields: [userId], references: [id])
  userId             Int?
  source             Source?               @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId           Int?
  sourceRun          SourceRun?            @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  sourceRunId        Int?
  dislikedBy         User?                 @relation("OpportunityDislikedBy", fields: [dislikedByUserId], references: [id], onDelete: SetNull)
  dislikedByUserId   Int?
  documents          OpportunityDocument[]
  matches            OpportunityMatch[]
  tender             Tender?

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, deadline])
  @@index([organizationId, status, fitScore, deadline])
  @@index([organizationId, dislikedAt, updatedAt])
  @@index([sourceId, publishedAt])
  @@map("opportunity")
}

model Source {
  id            Int                @id @default(autoincrement())
  key           String             @unique
  name          String
  type          String             @default("portal")
  baseUrl       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  opportunities Opportunity[]
  runs          SourceRun[]
  fingerprint   SourceFingerprint?

  @@map("source")
}

model SourceRun {
  id                     Int           @id @default(autoincrement())
  status                 String        @default("running")
  runStatus              RunStatus     @default(pending)
  startedAt              DateTime      @default(now())
  completedAt            DateTime?
  totalFound             Int           @default(0)
  matchedCount           Int           @default(0)
  newCount               Int           @default(0)
  errorCount             Int           @default(0)
  tendersProcessedCount  Int           @default(0)
  lastProcessedTenderRef String?
  completionMode         String?
  errorMessage           String?
  summary                Json?
  heartbeatAt            DateTime?
  leaseExpiresAt         DateTime?
  diagnostics            Json?
  cursor                 Json?
  metrics                Json?
  notificationSentAt     DateTime?
  notificationError      String?
  source                 Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId               Int
  opportunities          Opportunity[]
  deadLetters            DeadLetter[]

  @@index([sourceId, startedAt])
  @@index([sourceId, runStatus, startedAt])
  @@index([runStatus, leaseExpiresAt])
  @@map("sourceRun")
}

model DeadLetter {
  id           Int       @id @default(autoincrement())
  tenderRef    String
  sourceRunId  Int
  failureType  String
  failureCount Int       @default(1)
  lastError    String
  rawData      Json
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sourceRun    SourceRun @relation(fields: [sourceRunId], references: [id], onDelete: Cascade)

  @@index([tenderRef])
  @@index([sourceRunId])
  @@index([resolvedAt])
  @@map("deadLetter")
}

model SourceFingerprint {
  id          Int      @id @default(autoincrement())
  sourceId    Int
  fingerprint Json
  capturedAt  DateTime @default(now())
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId])
  @@map("sourceFingerprint")
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  result    Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("idempotencyRecord")
}

model OpportunityMatch {
  id              Int          @id @default(autoincrement())
  verdict         String       @default("Matched")
  fitScore        Int?
  matchedKeywords String[]     @default([])
  matchReasons    Json?
  digestSentAt    DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  opportunity     Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId   Int
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int

  @@unique([opportunityId, organizationId])
  @@index([organizationId, fitScore, verdict])
  @@map("opportunityMatch")
}

model OpportunityDocument {
  id            Int         @id @default(autoincrement())
  filename      String
  filepath      String
  storagePath   String?
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId Int
  uploadedAt    DateTime    @default(now())

  @@map("opportunityDocument")
}

model Tender {
  id                     Int                   @id @default(autoincrement())
  title                  String
  reference              String?
  entity                 String
  description            String?
  deadline               DateTime?
  briefingDate           DateTime?
  contactPerson          String?
  contactEmail           String?
  status                 String                @default("New")
  assignedTo             String?
  notes                  String?
  deadlineReminderSentAt DateTime?
  outcomeRecordedAt      DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId         Int
  createdBy              User?                 @relation(fields: [userId], references: [id])
  userId                 Int?
  opportunity            Opportunity?          @relation(fields: [opportunityId], references: [id])
  opportunityId          Int?                  @unique
  assignedUser           User?                 @relation("TenderAssignee", fields: [assignedUserId], references: [id])
  assignedUserId         Int?
  documents              TenderDocument[]
  checklistItems         TenderChecklistItem[]
  statusChanges          TenderStatusChange[]
  appeals                Appeal[]
  activities             ActivityLog[]
  contract               Contract?

  @@index([organizationId, status, deadline])
  @@index([organizationId, assignedUserId, deadline])
  @@map("tender")
}

model TenderDocument {
  id               Int      @id @default(autoincrement())
  filename         String
  filepath         String // Stores full Supabase Storage URL in production
  storagePath      String?
  documentCategory String   @default("SOURCE")
  tender           Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  tenderId         Int
  uploadedAt       DateTime @default(now())

  @@index([tenderId, uploadedAt])
  @@index([tenderId, documentCategory, uploadedAt])
  @@map("tenderDocument")
}

model TenderChecklistItem {
  id          Int       @id @default(autoincrement())
  label       String
  done        Boolean   @default(false)
  responsible String?
  dueDate     DateTime?
  notes       String?
  tender      Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  tenderId    Int

  @@index([tenderId, done])
  @@map("tenderChecklistItem")
}

model TenderStatusChange {
  id              Int      @id @default(autoincrement())
  tender          Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  tenderId        Int
  fromStatus      String
  toStatus        String
  reason          String?
  metadata        Json?
  changedAt       DateTime @default(now())
  changedBy       User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByUserId Int?
  createdAt       DateTime @default(now())

  @@index([tenderId, changedAt])
  @@index([changedByUserId, changedAt])
  @@map("tenderStatusChange")
}

model Contract {
  id                         Int                    @id @default(autoincrement())
  title                      String
  client                     String?
  assignedTo                 String?
  appointmentStatus          String                 @default("Appointed")
  instructionStatus          String                 @default("No Instruction")
  appointmentDate            DateTime?
  startDate                  DateTime?
  endDate                    DateTime?
  endDateReminderSentAt      DateTime?
  renewalDate                DateTime?
  renewalDateReminderSentAt  DateTime?
  cancelDate                 DateTime?
  firstInstructionDate       DateTime?
  lastFollowUpAt             DateTime?
  nextFollowUpAt             DateTime?
  nextFollowUpReminderSentAt DateTime?
  dormantReminderSentAt      DateTime?
  value                      Float?
  milestoneSummary           String?
  notes                      String?
  createdAt                  DateTime               @default(now())
  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId             Int
  tender                     Tender?                @relation(fields: [tenderId], references: [id])
  tenderId                   Int?                   @unique
  assignedUser               User?                  @relation("ContractAssignee", fields: [assignedUserId], references: [id])
  assignedUserId             Int?
  documents                  ContractDocument[]
  milestones                 ContractMilestone[]
  statusChanges              ContractStatusChange[]
  activities                 ActivityLog[]

  @@index([organizationId, appointmentStatus, instructionStatus])
  @@index([organizationId, endDate])
  @@index([organizationId, nextFollowUpAt])
  @@map("contract")
}

model ContractDocument {
  id           Int      @id @default(autoincrement())
  filename     String
  filepath     String
  storagePath  String?
  documentType String   @default("Other")
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId   Int
  uploadedAt   DateTime @default(now())

  @@map("contractDocument")
}

model ContractMilestone {
  id             Int       @id @default(autoincrement())
  title          String
  dueDate        DateTime?
  completedAt    DateTime?
  reminderSentAt DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  contract       Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId     Int

  @@index([contractId, dueDate])
  @@map("contractMilestone")
}

model ContractStatusChange {
  id              Int      @id @default(autoincrement())
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId      Int
  fieldName       String // "appointmentStatus" | "instructionStatus"
  oldValue        String
  newValue        String
  reason          String?
  metadata        Json?
  changedAt       DateTime @default(now())
  changedBy       User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByUserId Int?
  createdAt       DateTime @default(now())

  @@index([contractId, changedAt])
  @@index([changedByUserId, changedAt])
  @@map("contractStatusChange")
}

model Appeal {
  id                     Int              @id @default(autoincrement())
  reason                 String
  challengeType          String           @default("Administrative Appeal")
  exclusionReason        String?
  exclusionDate          DateTime?
  deadline               DateTime?
  status                 String           @default("Pending")
  submittedAt            DateTime?
  resolvedAt             DateTime?
  deadlineReminderSentAt DateTime?
  requestedRelief        String?
  nextStep               String?
  evidenceChecklist      Json?
  notes                  String?
  template               String?
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId         Int
  createdAt              DateTime         @default(now())
  tender                 Tender?          @relation(fields: [tenderId], references: [id])
  tenderId               Int?
  documents              AppealDocument[]
  activities             ActivityLog[]

  @@index([organizationId, status, deadline])
  @@map("appeal")
}

model AppealDocument {
  id           Int      @id @default(autoincrement())
  filename     String
  filepath     String
  storagePath  String?
  documentType String   @default("Evidence")
  uploadedAt   DateTime @default(now())
  appeal       Appeal   @relation(fields: [appealId], references: [id], onDelete: Cascade)
  appealId     Int

  @@map("appealDocument")
}

model Notification {
  id             Int           @id @default(autoincrement())
  title          String?
  message        String
  type           String        @default("info")
  read           Boolean       @default(false)
  sourceKey      String?       @unique
  linkUrl        String?
  linkLabel      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Int?
  user           User?         @relation(fields: [userId], references: [id])
  userId         Int?

  @@index([organizationId, read, createdAt])
  @@index([userId, read, createdAt])
  @@map("notification")
}

model TeamInvite {
  id              Int          @id @default(autoincrement())
  email           String
  name            String?
  role            String       @default("member")
  token           String       @unique
  status          String       @default("pending")
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  Int
  invitedBy       User?        @relation("TeamInvitesSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedByUserId Int?

  @@index([organizationId, status, expiresAt])
  @@index([organizationId, email])
  @@map("teamInvite")
}

model ActivityLog {
  id         Int       @id @default(autoincrement())
  action     String
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])
  userId     Int?
  tender     Tender?   @relation(fields: [tenderId], references: [id])
  tenderId   Int?
  contract   Contract? @relation(fields: [contractId], references: [id])
  contractId Int?
  appeal     Appeal?   @relation(fields: [appealId], references: [id])
  appealId   Int?

  @@map("activityLog")
}

model WebhookDelivery {
  id             Int          @id @default(autoincrement())
  webhookId      String       @unique // Idempotency key
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Int
  event          String // e.g., "tender.status_changed"
  webhookUrl     String
  payload        Json // Full webhook payload
  status         String       @default("pending") // "pending" | "delivered" | "failed"
  attempts       Int          @default(0)
  deliveredAt    DateTime?
  failureReason  String?
  nextRetryAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, nextRetryAt])
  @@index([webhookId])
  @@map("webhookDelivery")
}

model WebhookEndpoint {
  id             Int          @id @default(autoincrement())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Int
  url            String
  events         String[] // Events this endpoint subscribes to
  secret         String? // For HMAC signing
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
  @@map("webhookEndpoint")
}
